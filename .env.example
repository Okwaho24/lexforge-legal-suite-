# ─────────────────────────────────────────────
#  LexForge™ Environment Configuration
#  ARC-LXF-001 | Archer Chain Analytics | ISC: 102237785
#  NEVER commit a real .env. Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────

# Server
PORT=5200
NODE_ENV=production            # production = refuse to start with missing secrets

# Storage — in production DATA_DIR MUST be on a persistent volume (audit DB + delivered files live here)
DATA_DIR=/data/lexforge
# Optional overrides (defaults are under DATA_DIR):
# LEXFORGE_DB_PATH=/data/lexforge/lexforge.db
# WORK_DIR=/data/lexforge/work           # must be inside AcerbE's ACERBE_ALLOWED_INPUT_DIRS
# DELIVERED_DIR=/data/lexforge/delivered
TEMPLATES_DIR=./templates
LOGS_DIR=./logs

# Public base URL used to build absolute download links (no trailing slash). Empty = relative links.
PUBLIC_BASE_URL=

# Signed download links (>=32 chars) and lifetime in seconds
DOWNLOAD_SIGNING_SECRET=
DOWNLOAD_LINK_TTL=3600

# ─── RaPaX™ → LexForge™ webhook (>=16 chars; shared with RaPaX) ───
RAPAX_WEBHOOK_SECRET=

# ─── AcerbE™ fingerprinting (mandatory gate; must run on the SAME machine/container) ───
ACERBE_BASE_URL=http://127.0.0.1:7749
ACERBE_API_KEY=                # >=16 chars; must equal the AcerbE server's ACERBE_API_KEY
ACERBE_TIMEOUT_MS=20000
ACERBE_RETRIES=2

# ─── Template behaviour ───
ALLOW_EN_FALLBACK=false        # true = silently deliver EN when a locale is missing (not recommended for paid orders)
SELLABLE_LANGUAGES=EN          # only languages with real translated text; non-EN repo files are English copies
RESTRICTED_DOCUMENTS=PSA:CA;CES:CA;INV:CA   # docs whose non-CA text does not match the product name
PLACEHOLDER_MODE=fill          # fill = visible [FIELD: ____] blanks | strict = reject (422) if any variable is missing
MIN_TEMPLATE_BYTES=400         # smaller templates are treated as empty stubs and refused

# ─── XRPL anchoring ───
# Seed: store ONLY in a secret manager / ~/security/xrpl.seed — never in git.
XRPL_SEED=
XRPL_NETWORK=testnet           # testnet | devnet | mainnet
XRPL_ENABLED=true
XRPL_ANCHOR_MODE=async         # async = anchor after the response (retried) | sync = wait inside the request
# XRPL_DEST_ADDRESS=           # optional: 1-drop Payment to this address instead of AccountSet
# XRPL_ENDPOINT=               # optional: override websocket endpoint

# Issuer string printed on every document
ISSUED_BY=Archer Chain Analytics | ISC: 102237785
